<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2>Produtos</h2>
    <p class="text-body-secondary mb-0">Cadastro de produtos do Exercício II.</p>
  </div>
  <a href="/products/create" class="btn btn-primary">Novo produto</a>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Preço</th>
        <th>Descrição</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      {{#each products}}
        <tr>
          <td>{{id}}</td>
          <td>{{name}}</td>
          <td>R$ {{price}}</td>
          <td>{{description}}</td>
          <td class="text-end">
            <a href="/products/{{id}}/edit" class="btn btn-sm btn-warning">Editar</a>
            <form action="/products/{{id}}/delete" method="post" class="d-inline">
              <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
            </form>
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="5" class="text-center">Nenhum produto cadastrado.</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>
